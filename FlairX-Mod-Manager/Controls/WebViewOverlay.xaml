<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FlairX_Mod_Manager.Controls.WebViewOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Minimal in-app browser used for flows that need a real session:
        GameBanana login and Cloudflare bypass.

        Not wired in yet - the existing dialogs are still in use, so this control can be
        reviewed and reverted without touching anything.
    -->
    <Grid x:Name="RootGrid"
          Visibility="Collapsed"
          Background="{ThemeResource LauncherAcrylicBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: title, address, reload -->
        <Grid Grid.Row="0" Padding="16,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Column="0"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="AddressText"
                       Grid.Column="1"
                       Opacity="0.7"
                       IsTextSelectionEnabled="True"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>

            <Button x:Name="ReloadButton"
                    Grid.Column="2"
                    Click="ReloadButton_Click"
                    ToolTipService.ToolTip="Reload"
                    Padding="10,6">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Page -->
        <Border Grid.Row="1"
                Margin="16,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid x:Name="WebViewHost"/>
        </Border>

        <!-- Bottom bar: zoom, cookies, continue/cancel -->
        <Grid Grid.Row="2" Padding="16,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ZoomLabel"
                       Grid.Column="0"
                       Text="Zoom"
                       Opacity="0.7"
                       VerticalAlignment="Center"/>

            <Slider x:Name="ZoomSlider"
                    Grid.Column="1"
                    Width="160"
                    Minimum="50"
                    Maximum="200"
                    Value="100"
                    StepFrequency="10"
                    VerticalAlignment="Center"
                    ValueChanged="ZoomSlider_ValueChanged"/>

            <TextBlock x:Name="ZoomText"
                       Grid.Column="2"
                       Text="100%"
                       MinWidth="48"
                       Opacity="0.7"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="StatusText"
                       Grid.Column="3"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>

            <Button x:Name="GetCookiesButton"
                    Grid.Column="4"
                    Click="GetCookiesButton_Click"
                    Content="Get Cookies"/>

            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
                <CheckBox x:Name="DontAskAgainCheckBox"
                          Content="Don't ask again"
                          VerticalAlignment="Center"/>
                <Button x:Name="CancelButton"
                        Click="CancelButton_Click"
                        Content="Cancel"/>
                <Button x:Name="ContinueButton"
                        Click="ContinueButton_Click"
                        Style="{ThemeResource AccentButtonStyle}"
                        Content="Continue"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

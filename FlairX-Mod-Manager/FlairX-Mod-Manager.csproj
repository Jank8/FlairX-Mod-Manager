<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================
       PROJECT CONFIGURATION
       ======================================== -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RollForward>LatestPatch</RollForward>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <!-- Application Identity -->
    <AssemblyName>FlairX Mod Manager</AssemblyName>
    <RootNamespace>FlairX_Mod_Manager</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    
    <!-- Version Information -->
    <Version>4.2.0</Version>
    <AssemblyVersion>4.2.0.0</AssemblyVersion>
    <FileVersion>4.2.0.0</FileVersion>
    <AssemblyTitle>FlairX Mod Manager</AssemblyTitle>
    <AssemblyDescription>Advanced mod manager for games with global hotkey support and WinUI3 2.0 compatibility</AssemblyDescription>
    <AssemblyCompany>FlairX</AssemblyCompany>
    <AssemblyProduct>FlairX Mod Manager</AssemblyProduct>
    <AssemblyCopyright>Copyright © 2026 FlairX</AssemblyCopyright>
    
    <!-- Platform Configuration -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    
    <!-- Publishing Configuration -->
    <WindowsPackageType>None</WindowsPackageType>
    <PublishProfile>win-x64.pubxml</PublishProfile>
    
    <!-- Fix version conflicts -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <!-- ========================================
       NUGET DEPENDENCIES
       
       IMPORTANT: Check for package updates regularly!
       Command: dotnet list package (outdated flag)
       Last updated: 2026-10-24 (v4.2.0)
       ======================================== -->
  <ItemGroup>
    <!-- WinUI 3 Community Toolkit -->
    <PackageReference Include="CommunityToolkit.Common" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI" Version="7.1.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Media" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.Labs.WinUI.Controls.MarkdownTextBlock" Version="0.1.251217-build.2433" />
    <PackageReference Include="CommunityToolkit.WinUI.Behaviors" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    
    <!-- Microsoft Packages -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="ReverseMarkdown" Version="6.3.0" />
    <PackageReference Include="SharpSevenZip" Version="2.0.130" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    
    <!-- Graphics & Scripting -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
    <PackageReference Include="NLua" Version="1.7.9" />
    
    <!-- WebView2 for Cloudflare bypass -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />

  </ItemGroup>

  <!-- ========================================
       APPLICATION RESOURCES
       ======================================== -->
  <ItemGroup>
    <!-- Application Icons -->
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    
    <!-- Application Fonts -->
    <Content Include="Assets\Fonts\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    
    <!-- Kenney Input Prompts Fonts -->
    <Resource Include="Assets\KenneyFonts\*.ttf" />
    <Content Include="Assets\KenneyFonts\License.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    
    <!-- Language Files -->
    <Content Include="Language\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    

  </ItemGroup>

  <!-- ========================================
       POST-BUILD CLEANUP & STRUCTURE CREATION
       ======================================== -->
  <Target Name="GeneratePackageVersionsFile" BeforeTargets="Build">
    <PropertyGroup>
      <PackageVersionsJson>
{
  "Microsoft.WindowsAppSDK": "2.5.1",
  "SharpSevenZip": "2.0.130",
  "NLua": "1.7.9",
  "CommunityToolkit.WinUI.Media": "8.2.251219",
  "ppy.SDL3-CS": "2026.629.0",
  "System.Drawing.Common": "10.0.13",
  "SixLabors.ImageSharp": "4.1.3"
}
      </PackageVersionsJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutputPath)Settings\package-versions.json" Lines="$(PackageVersionsJson)" Overwrite="true" />
  </Target>

  <Target Name="CleanupUnnecessaryFiles" AfterTargets="Build">
    <ItemGroup>
      <LooseXbfFiles Include="$(OutputPath)*.xbf" />
      <PagesDirectory Include="$(OutputPath)Pages" Condition="Exists('$(OutputPath)Pages')" />
      <RuntimeFilesToDelete Include="$(OutputPath)createdump.exe" />
    </ItemGroup>
    
    <!-- Create Settings directory -->
    <MakeDir Directories="$(OutputPath)Settings" />
    
    <!-- Create game-specific XXMI subdirectories with Mods folders -->
    <MakeDir Directories="$(OutputPath)XXMI\ZZMI\Mods" />
    <MakeDir Directories="$(OutputPath)XXMI\GIMI\Mods" />
    <MakeDir Directories="$(OutputPath)XXMI\WWMI\Mods" />
    <MakeDir Directories="$(OutputPath)XXMI\SRMI\Mods" />
    <MakeDir Directories="$(OutputPath)XXMI\HIMI\Mods" />
    <MakeDir Directories="$(OutputPath)XXMI\EFMI\Mods" />
    
    <!-- Delete unnecessary files -->
    <Delete Files="@(LooseXbfFiles)" ContinueOnError="true" />
    <RemoveDir Directories="@(PagesDirectory)" ContinueOnError="true" />
    <Delete Files="@(RuntimeFilesToDelete)" ContinueOnError="true" />
    <Delete Files="@(IconFilesToDelete)" ContinueOnError="true" />
  </Target>

</Project>
